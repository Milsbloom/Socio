# Copy to .env for local work. On Hostinger, set these as the Node.js app's environment variables.

# Public address of the app, no trailing slash. Redirect URLs are built from this.
APP_URL=https://socio.example.com

# MySQL. On Hostinger use host 127.0.0.1, port 3306.
DATABASE_URL=mysql://USER:PASSWORD@127.0.0.1:3306/DATABASE

# 64 hex characters. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=
# Any long random string. Signs login sessions and OAuth state.
SESSION_SECRET=
# Any long random string. The cron job sends it to /api/cron/publish.
CRON_SECRET=

# Where uploaded media is stored on disk. Served publicly at APP_URL/media/...
MEDIA_DIR=./uploads

# Platform apps (see the setup guides). Leave blank for platforms not set up yet.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_PAGES_CLIENT_ID=
LINKEDIN_PAGES_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional. Who can see TikTok posts once TikTok has audited the app (until then posts are private).
# One of PUBLIC_TO_EVERYONE, MUTUAL_FOLLOW_FRIENDS, FOLLOWER_OF_CREATOR, SELF_ONLY.
TIKTOK_PRIVACY_LEVEL=SELF_ONLY
# Optional. public, unlisted or private. YouTube forces private until Google verifies the app.
YOUTUBE_PRIVACY=public

# Let AI tools (Claude, API keys) publish and schedule. Off: they can only create drafts.
AI_CAN_PUBLISH=false
