{
  "name": "socio",
  "version": "0.1.0",
  "private": true,
  "description": "Publish one post to Instagram, Facebook, TikTok, X, LinkedIn and YouTube, from a web app or from AI tools over MCP.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -p ${PORT:-3000}",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "create-user": "tsx scripts/create-user.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "drizzle-orm": "0.45.4",
    "mysql2": "3.24.6",
    "next": "15.5.29",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "tsx": "4.20.6",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "drizzle-kit": "0.31.5",
    "typescript": "5.9.2"
  }
}
